{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/provenance.schema.json",
  "title": "Provenance",
  "description": "Where an entry came from and when it was observed.",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "log",
        "manual",
        "import",
        "default",
        "other"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    }
  },
  "required": [
    "source"
  ]
}
