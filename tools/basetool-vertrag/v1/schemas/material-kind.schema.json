{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/material-kind.schema.json",
  "title": "Material kind",
  "description": "Read-only classification a client uses to route rows to its own lists.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "RAW",
        "REFINED",
        "NO_REFINE"
      ]
    },
    "commodity": {
      "type": "boolean",
      "description": "True when the material is a UEX commodity (trade good)."
    }
  },
  "required": [
    "type",
    "commodity"
  ]
}
