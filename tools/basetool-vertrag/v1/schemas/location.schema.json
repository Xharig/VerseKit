{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/location.schema.json",
  "title": "Location",
  "description": "A non-hidden Lager location a client may offer.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "uex": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CITY",
            "SPACE_STATION"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    }
  },
  "required": [
    "name"
  ]
}
