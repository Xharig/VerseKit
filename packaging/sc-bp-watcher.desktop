[Desktop Entry]
Type=Application
Name=Verse-Kit
Comment=Dein Werkzeugkasten für Star Citizen
Comment[en]=Your Star Citizen toolkit
# ⚠ Exec und Icon BLEIBEN: Das ist der Name der Binary im AppImage und der
# Symboldatei — beide sind unsichtbar und wurden nicht umbenannt.
Exec=SC-BP-Watcher
Icon=sc-bp-watcher
Categories=Game;Utility;
Terminal=false
# ⚠ Die Fensterklasse, an der die Arbeitsumgebung das laufende Fenster dieser
# Verknuepfung zuordnet — NICHT der Anzeigename. Muss mit `paths.WM_CLASS`
# uebereinstimmen; hier fehlte der Eintrag ganz (ergaenzt 18.09.2026).
StartupWMClass=Versekit
